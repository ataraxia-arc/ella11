# Safety net when a host points the domain at the project root
# instead of the public directory. The preferred document root is /public.
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^(?:\.env(?:\..*)?|artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|vite\.config\.js|phpunit\.xml) - [F,L]
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(?:/|$) - [F,L]

    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
